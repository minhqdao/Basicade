{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["vite/client"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "maxNodeModuleJsDepth": 2
  },
  "include": [
    "demos/launcher.js",
    "demos/runner.worker.js",
    "demos/catalog.js",
    "demos/catalog-manifest.js",
    "demos/catalog-schema.js",
    "demos/routes.js"
  ]
}
